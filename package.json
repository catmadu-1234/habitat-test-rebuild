{
  "name": "habitat-test-rebuild",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "cf:build": "rm -rf .next && opennextjs-cloudflare build",
    "cf:preview": "rm -rf .next && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "rm -rf .next && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "prebuild": "rm -rf .next/cache/fetch-cache",
    "test": "node --test lib/*.test.ts sanity/lib/*.test.ts",
    "typegen": "npm --prefix ../studio-habitat-learn-test run typegen"
  },
  "dependencies": {
    "@sanity/image-url": "^2.1.1",
    "next": "16.3.6",
    "next-sanity": "^13.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "wrangler": "^4.137.0"
  }
}
